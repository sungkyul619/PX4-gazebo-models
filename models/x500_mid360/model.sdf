
<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_mid360'>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://mid360</uri>
        <pose relative_to="base_link">0.125 0 0.001 0 0 0</pose>
    </include>
    <joint name="livox_joint" type="fixed">
      <parent>base_link</parent>
      <child>mid360/livox_link</child>
    </joint>
  </model>
</sdf>

