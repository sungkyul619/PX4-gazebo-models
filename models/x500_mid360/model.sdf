<?xml version="1.0"?>
<sdf version="1.9">
  <model name="x500_with_livox">

    <!-- 기존 x500 모델의 링크들 (예: base_link, imu_link 등) -->
    <include>
      <uri>model://x500</uri>
      <pose>0 0 0 0 0 0</pose>
      <name>x500_body</name>
    </include>
    <include>
      <uri>model://mid360</uri>
      <pose relative_to="x500_body::base_link">0.125 0 0.001 0 0 0</pose>
      <name>mid360</name>
    </include>

    <!-- base_link에 livox_link 고정 -->
    <joint name="livox_joint" type="fixed">
      <parent>x500_body::base_link</parent>
      <child>mid360::livox_link</child>
    </joint>

  </model>
</sdf>
