<?xml version="1.0"?>
<sdf version="1.7">
  <model name="mid360">
    <link name="mid360/livox_link">
      <!-- <plugin filename="VisualizeLidar" name="Visualize Lidar">
      </plugin> -->

      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>0 0 0.07121186 0 0 0</pose>
        <mass>0.83</mass>
        <inertia>
          <ixx>0.002853261803275034</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002853261803275034</iyy>
          <iyz>0</iyz>
          <izz>0.0029004988906384237</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0.07121186 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08360116</radius>
            <length>0.14242372</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://lidar_3d_v2/meshes/lidar_3d_v2.dae</uri>
            <scale>0.3 0.3 0.3</scale>
          </mesh>
        </geometry>
      </visual>

      <sensor name="livox_lidar" type="gpu_lidar">
        <pose>0 0 0.07121186 0 0 0</pose>
        <update_rate>10</update_rate>
        <!-- <topic>scan</topic> -->
        <lidar>
          <scan>
            <horizontal>
              <samples>400</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28319</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>  <!-- GPU 부담 줄이기 위한 값, 07 라이다모델 sdf수정최종 참고 -->
              <resolution>1</resolution>
              <min_angle>-0.1222</min_angle> <!-- -7 deg -->
              <max_angle>0.9076</max_angle>  <!-- 52 deg -->
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>70.0</max>  <!-- 최대 70m (스펙 기반) -->
            <resolution>0.002</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>  <!-- 표준편차, 1cm -->
          </noise>
        </lidar>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
